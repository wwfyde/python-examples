    "import torch\n",
    "\n",
    "img = torch.randint(0, 256, (16, 16, 4), dtype=torch.uint8)\n",
    "img[..., 0] = 0  #  R通道\n",
    "# 第3维（Alpha通道）全部赋值为255\n",
